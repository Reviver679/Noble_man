# ---------------------------------------------------------------------------
# Backend (Frappe / new_face)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=https://api.nobilified.com
FACE_SWAP_TOKEN=

# ---------------------------------------------------------------------------
# Admin area (/admin)
# ---------------------------------------------------------------------------
# Password the admin types at /admin/login.
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Which content backend the admin writes to. Supported: frappe
CMS_PROVIDER=frappe

# Frappe API key/secret for a user with the System Manager role.
# In Frappe: User > (pick user) > API Access > Generate Keys.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ---------------------------------------------------------------------------
# Shopify
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SHOP_DOMAIN=
NEXT_PUBLIC_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_SECRET=
NEXT_SHOPIFY_CLIENT_ID=
NEXT_SHOPIFY_CLIENT_SECRET=

NEXT_DIGITAL_VARIENT_ID=
NEXT_PHYSICAL_PRINT_VARIENT_ID=
NEXT_CANVAS_CLASSIC_VARIANT_ID=
NEXT_CANVAS_ROYAL_VARIANT_ID=
NEXT_CANVAS_GRAND_VARIANT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
